<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_white_circle"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:tint="@color/black"
        android:elevation="4dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="뒤로가기"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 💡 부모의 Bottom 제약을 제거하고 뒤로가기 버튼에 수직 정렬을 완전 고정시킵니다 -->
    <TextView
        android:id="@+id/tv_add_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="정보 입력"
        style="@style/TitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back" />

    <!-- ★ 문서 편집 시에만 나타날 파란 체크 버튼 ★ -->
    <ImageButton
        android:id="@+id/btn_done"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_blue_circle"
        android:backgroundTint="#4A89FF"
        android:elevation="4dp"
        android:padding="12dp"
        android:src="@drawable/ic_check_white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_add_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_add_title"
        app:tint="#FFFFFF"
        tools:visibility="visible"/>

    <!-- ★ 문서 편집 시에만 나타날 임시저장 버튼 ★ -->
    <ImageButton
        android:id="@+id/btn_draft"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_white_circle"
        android:elevation="4dp"
        android:padding="12dp"
        android:src="@drawable/ic_archive"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_add_title"
        app:layout_constraintEnd_toStartOf="@id/btn_done"
        app:layout_constraintTop_toTopOf="@id/tv_add_title"
        app:tint="#333333"
        tools:visibility="visible"
        android:contentDescription="임시저장"/>

    <!-- 프래그먼트 컨테이너 (여기에 정보입력/문서편집 화면이 번갈아 뜸) -->
    <FrameLayout
        android:id="@+id/course_frame_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_add_title"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_switcher" />

    <!-- ★ 문서 편집 시에만 나타날 섹션 추가 버튼 ★ -->
    <LinearLayout
        android:id="@+id/layout_section_add_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_switcher">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add_text_activity"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_white_round_stroke"
            android:drawableStart="@drawable/ic_btn_add"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            android:text="텍스트 섹션 추가"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add_image_activity"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_white_round_stroke"
            android:drawableStart="@drawable/ic_btn_add"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            android:text="이미지 섹션 추가"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 하단 스위처 -->
    <LinearLayout
        android:id="@+id/layout_bottom_switcher"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:background="@drawable/bg_search_group"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toTopOf="@id/keyboard_spacer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btn_switch_info"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_inner_search_bar"
            android:backgroundTint="#E8E8E8"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iv_info_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_diamond_blue"
                app:tint="#4A89FF" />
            <TextView
                android:id="@+id/tv_info_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정보"
                android:textSize="12sp"
                android:textColor="#4A89FF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_switch_edit"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iv_edit_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_circle_black"
                app:tint="#000000" />
            <TextView
                android:id="@+id/tv_edit_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="편집"
                android:textSize="12sp"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- 높이를 고정값(70dp)이 아닌 0dp로 변경하고, 제약 조건을 위아래로 모두 연결한 뒤
    가상 가중치(match_constraint_percent)를 부여합니다. 이렇게 하면 평소에는 전체 화면의 딱 70dp 만큼 공간을 벌려주다가,
     키보드가 켜져서 전체 화면이 수축하면 자기 높이를 0dp로 스스로 압축하며 흔적도 없이 사라집니다. -->
    <View
        android:id="@+id/keyboard_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        android:minHeight="0dp"
        app:layout_constraintHeight_max="40dp"
        app:layout_constraintHeight_min="0dp" />

    <!-- ★ 로딩 중 배경을 어둡게 막아주는 오버레이 (클릭 방지용) ★ -->
    <View
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:elevation="99dp" />

    <!-- ★ 정중앙에 위치할 로딩 바 ★ -->
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:elevation="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>