<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageButton
        android:id="@+id/btn_profile"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/bg_white_circle"
        android:elevation="4dp"
        android:padding="10dp"
        android:src="@drawable/ic_profile"
        android:contentDescription="프로필"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.075" />

    <TextView
        android:id="@+id/tv_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="강좌 목록"
        style="@style/TitleText"
        app:layout_constraintBottom_toBottomOf="@id/btn_profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_profile" />

    <!-- 관리자 계정일 때만 보이는 다기능 추가 버튼 -->
    <ImageButton
        android:id="@+id/btn_add"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_white_circle"
        android:elevation="4dp"
        android:padding="10dp"
        android:src="@drawable/ic_admin_settings"
        android:contentDescription="관리자 메뉴"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btn_profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_profile"
        tools:visibility="visible" />

    <!-- 메인 강좌 영역 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btn_profile"
        app:layout_constraintBottom_toTopOf="@id/layout_search_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout="@layout/fragment_main_list" />

    <!-- layout_search_group의 배경을 흰색 라운드 처리하여 전체가 하나로 보이게 함 -->
    <LinearLayout
        android:id="@+id/layout_search_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/bg_search_group"
        android:elevation="8dp"
        android:padding="4dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintBottom_toBottomOf="parent" >

        <!-- 1. 검색 영역 (배경 없이 투명하게) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_inner_search_bar"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_search" />
            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="강좌 검색하기"
                android:paddingStart="12dp"
                android:textSize="15sp"
                android:inputType="text"
                android:importantForAutofill="no"
                tools:ignore="RtlSymmetry" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mic"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true" />
        </LinearLayout>

        <!-- 2. 구분선 (틀에 갇힌 느낌을 없애는 핵심) -->
        <View
            android:id="@+id/search_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="#EEEEEE"
            android:visibility="gone"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <!-- 3. 태그 영역 (배경 없이 일체화) -->
        <LinearLayout
            android:id="@+id/layout_tag_area"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:visibility="gone"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <ImageView
                android:id="@+id/btn_add_tag"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_btn_add"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_item"
                android:layout_marginStart="8dp"
                android:focusable="false"
                android:focusableInTouchMode="false" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>