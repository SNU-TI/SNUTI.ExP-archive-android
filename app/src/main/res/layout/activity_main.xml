<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="60dp"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 상단 좌측 프로필 버튼 -->
        <ImageButton
            android:id="@+id/btn_profile"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_white_circle"
            android:elevation="4dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_profile"
            android:contentDescription="프로필"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 상단 중앙 타이틀 -->
        <TextView
            android:id="@+id/tv_main_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="강좌 목록"
            style="@style/TitleText"
            app:layout_constraintBottom_toBottomOf="@id/btn_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_profile" />

        <!-- 관리자 계정일 때만 보이는 다기능 추가 버튼 -->
        <ImageButton
            android:id="@+id/btn_add"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_white_circle"
            android:elevation="4dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_admin_settings"
            android:contentDescription="관리자 메뉴"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btn_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_profile"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 메인 강좌 영역 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/layout_top"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout="@layout/fragment_main_list" />

    <!-- [추가] 키보드가 올라왔을 때 나타나는 태그 검색 영역 컨테이너 -->
    <LinearLayout
        android:id="@+id/layout_tag_search_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_search_group"
        android:elevation="8dp"
        android:padding="12dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/layout_search_bar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1단계: 선택된 태그 영역 (태그 검색 + 선택된 칩들) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="태그 검색"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginEnd="12dp" />

            <!-- 사용자가 선택한 태그들이 동적으로 추가될 수 있는 가로 리사이클러뷰 영역 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/layout_selected_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_horizontal_tag"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- 구분선 (선택 영역과 전체 태그 목록 경계) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="8dp" />

        <!-- 2단계: 저장된 모든 전체 태그 목록 휠 스크롤 영역 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/layout_all_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_horizontal_tag"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- [추가] 키보드가 올라왔을 때 나타나는 실제 입력형 검색바 컨테이너 -->
    <LinearLayout
        android:id="@+id/layout_search_bar_container"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_group"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 돋보기 아이콘 -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="#333333"
            android:contentDescription="검색" />

        <!-- 텍스트 입력 에디트텍스트 -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:textSize="15sp"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <!-- 마이크 아이콘 (선택 사항) -->
        <ImageView
            android:id="@+id/btn_mic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_mic"
            android:visibility="gone"
            tools:visibility="visible"
            app:tint="#666666"
            android:contentDescription="음성 검색" />

        <!-- X(클리어) 버튼 -->
        <ImageButton
            android:id="@+id/btnClearSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            tools:visibility="visible"
            app:tint="#333333"
            android:contentDescription="검색어 초기화" />
    </LinearLayout>

    <!-- 하단 전체/맞춤/저장 탭 바 + 우측 검색 버튼 영역 -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 좌측: [전체 / 맞춤 / 저장이 포함된 알약 모양 컨테이너] -->
        <LinearLayout
            android:id="@+id/layout_search_group"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_search_group"
            android:elevation="6dp"
            android:padding="4dp"
            android:gravity="center">

            <!-- 1. 전체 탭 -->
            <LinearLayout
                android:id="@+id/btn_tab_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_inner_search_bar"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_all"
                    android:contentDescription="전체 아이콘" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="전체"
                    android:textSize="11sp"
                    android:textColor="#4A89FF"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 2. 맞춤 탭 -->
            <LinearLayout
                android:id="@+id/btn_tab_custom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_custom"
                    android:contentDescription="맞춤 아이콘" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="맞춤"
                    android:textSize="11sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 3. 저장 탭 -->
            <LinearLayout
                android:id="@+id/btn_tab_saved"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_saved"
                    android:contentDescription="저장 아이콘" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="저장"
                    android:textSize="11sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 우측: 독립된 돋보기(검색) 원형 버튼 -->
        <ImageButton
            android:id="@+id/btn_search_toggle"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_white_circle"
            android:elevation="6dp"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search"
            app:tint="#000000"
            android:contentDescription="검색 버튼" />

    </LinearLayout>

    <!-- 키보드 밀림 방지용 스페이서 뷰 -->
    <View
        android:id="@+id/keyboard_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        android:minHeight="0dp"
        app:layout_constraintHeight_max="40dp"
        app:layout_constraintHeight_min="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>