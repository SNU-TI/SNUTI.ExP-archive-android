<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp"> <!-- 키보드가 올라와도 마지막 항목이 가려지지 않게 여유 공간 확보 -->

            <!-- 입력 컨테이너: 타이틀 바로 아래로 바짝 붙임 -->
            <LinearLayout
                android:id="@+id/layout_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <!-- 제목 입력 (높이 44dp로 슬림화) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:background="@drawable/bg_bottom_line"
                    android:gravity="top"
                    android:paddingVertical="12dp">
                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="제목"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                    <EditText
                        android:id="@+id/et_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:textSize="14sp"
                        android:hint="강좌 제목 입력"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:scrollHorizontally="false"/>
                </LinearLayout>

                <!-- 강연자 & 날짜 (한 줄로 배치하여 공간 절약) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:background="@drawable/bg_bottom_line" android:gravity="center_vertical">
                        <TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="강연자" android:textStyle="bold" />
                        <EditText android:id="@+id/et_speaker" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:textSize="14sp" android:singleLine="true"/>
                    </LinearLayout>
                    <View android:layout_width="15dp" android:layout_height="1dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_bottom_line" android:gravity="center_vertical">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="일시" android:textStyle="bold" />
                        <EditText android:id="@+id/et_date"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:minHeight="48dp"
                            android:background="@null"
                            android:textSize="14sp"
                            android:focusable="false"
                            android:clickable="true"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 주제, 위치, 요약 (간격 marginTop="4dp"로 최소화) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="44dp" android:background="@drawable/bg_bottom_line" android:gravity="top" android:paddingVertical="12dp">
                    <TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="주제" android:textStyle="bold" />
                    <EditText android:id="@+id/et_subject" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:textSize="14sp" android:inputType="textMultiLine" android:scrollHorizontally="false" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="44dp" android:background="@drawable/bg_bottom_line" android:gravity="top" android:paddingVertical="12dp">
                    <TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="위치" android:textStyle="bold" />
                    <EditText android:id="@+id/et_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:textSize="14sp" android:inputType="textMultiLine" android:scrollHorizontally="false" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="44dp" android:background="@drawable/bg_bottom_line" android:gravity="top" android:paddingVertical="12dp">
                    <TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="요약" android:textStyle="bold" />
                    <EditText android:id="@+id/et_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:textSize="14sp" android:inputType="textMultiLine" android:scrollHorizontally="false" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="44dp" android:background="@drawable/bg_bottom_line" android:gravity="top" android:paddingVertical="12dp">
                    <TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="영상" android:textStyle="bold" />
                    <EditText android:id="@+id/et_video" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:textSize="14sp" android:inputType="textMultiLine" android:scrollHorizontally="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. 태그 영역: 입력란 바로 아래 배치 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_tag_container"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="태그"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <!-- 가로 스크롤 적용 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_selected_tags"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:scrollbars="none"/>

                <ImageButton
                    android:id="@+id/btn_toggle_tag_input"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_btn_add"
                    app:tint="#4A90E2"
                    android:contentDescription="태그 추가 열기/닫기" />
            </LinearLayout>

            <!-- [중간 줄 + 맨 아랫줄을 하나로 묶은 큰 블럭] -->
            <LinearLayout
                android:id="@+id/layout_tag_input_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tag_container"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <!-- 중간 줄: 태그 검색 입력창 및 '추가하기' 버튼 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_search_group"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_btn_add"
                            app:tint="#999999" />

                        <EditText
                            android:id="@+id/et_tag_search"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="태그 검색 또는 입력"
                            android:textSize="13sp"
                            android:singleLine="true"
                            android:inputType="text" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_add_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:text="추가하기"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#999999" />
                </LinearLayout>

                <!-- 맨 아랫줄: 기존 태그 또는 검색 결과 추천 태그 목록 (가로 스크롤) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_recommended_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:scrollbars="none"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>