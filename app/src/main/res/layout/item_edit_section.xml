<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_section_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Section 1"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <!-- 텍스트 입력창 또는 이미지 표시 영역 (동적 전환) -->
        <EditText
            android:id="@+id/et_section_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:background="@null"
            android:hint="내용을 입력하세요"
            android:gravity="top"
            android:layout_marginTop="8dp"/>

        <ImageView
            android:id="@+id/iv_section_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>

        <!-- 하단 도구 모음 (텍스트/이미지 추가 및 삭제) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <Button android:layout_width="wrap_content" android:layout_height="36dp" android:text="텍스트 추가" android:textSize="12sp" style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
                <Button android:layout_width="wrap_content" android:layout_height="36dp" android:text="이미지 추가" android:textSize="12sp" style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_delete_section"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_delete_red"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>